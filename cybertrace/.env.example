# Copy to backend/.env or export these. Never commit real keys.

# Optional. Without it the agent uses the offline rules engine (fully functional, no AI narrative).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. Without it IP reputation is labelled "local heuristic only".
ABUSEIPDB_API_KEY=

# Storage locations
CYBERTRACE_DB=cybertrace.db
CYBERTRACE_DATA=./data

# Comma-separated origins if the frontend is hosted separately (e.g. Vercel)
ALLOWED_ORIGINS=*
